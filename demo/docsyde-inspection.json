{
  "repository": "https://github.com/abishek1303/docksyde-demo-app-test-subject",
  "id": "request-desk-product-improvements",
  "version": "3",
  "description": "Read-only workload overview, bulk-triage controls, issue intake, search, board, and project form checkpoints. No records are created or updated.",
  "runtime": {
    "mode": "attach",
    "options": {
      "baseUrl": "http://localhost:5173",
      "readinessPath": "/api/stats",
      "startupTimeoutMs": 60000
    }
  },
  "workflow": {
    "path": "/?agent",
    "readySelector": "button[aria-label=\"New issue\"]",
    "steps": [
      {
        "type": "checkpoint"
      },
      {
        "type": "click",
        "selector": "button[aria-label=\"View Workload\"]"
      },
      {
        "type": "waitFor",
        "selector": ".workload-panels"
      },
      {
        "type": "checkpoint"
      },
      {
        "type": "click",
        "selector": "button[aria-label=\"View My Issues\"]"
      },
      {
        "type": "waitFor",
        "selector": "section[aria-label=\"Bulk triage\"]"
      },
      {
        "type": "click",
        "selector": "button[aria-label=\"New issue\"]"
      },
      {
        "type": "waitFor",
        "selector": "#issue-due-date"
      },
      {
        "type": "checkpoint"
      },
      {
        "type": "click",
        "selector": "button[aria-label=\"Cancel\"]"
      },
      {
        "type": "fill",
        "selector": "input[aria-label=\"Search issues\"]",
        "value": "launch"
      },
      {
        "type": "waitFor",
        "selector": "button[aria-label=\"Clear search\"]"
      },
      {
        "type": "checkpoint"
      },
      {
        "type": "click",
        "selector": "button[aria-label=\"Clear search\"]"
      },
      {
        "type": "click",
        "selector": "button[aria-pressed]"
      },
      {
        "type": "waitFor",
        "selector": ".demo-board"
      },
      {
        "type": "checkpoint"
      },
      {
        "type": "click",
        "selector": "button[aria-label=\"View Projects\"]"
      },
      {
        "type": "click",
        "selector": "button[aria-label=\"New project\"]"
      },
      {
        "type": "waitFor",
        "selector": "#project-description"
      },
      {
        "type": "checkpoint"
      }
    ],
    "sensitiveSelectors": [
      "input, textarea"
    ],
    "limits": {
      "maxCheckpoints": 24,
      "maxStates": 48,
      "maxScreenshotBytes": 8388608,
      "timeoutMs": 45000
    }
  },
  "maxSelectedScreenshots": 3,
  "supportedPathnames": [
    "/"
  ],
  "capabilities": [
    {
      "id": "workload-planning",
      "pathname": "/",
      "description": "Inspect workspace-wide workload metrics, issue status breakdown, active deadline queue and drill-down controls."
    },
    {
      "id": "issue-triage",
      "pathname": "/",
      "description": "Inspect bulk status/priority controls, issue intake fields, description search and board layout without changing records."
    }
  ],
  "supportingSourcePaths": [
    "src/client/components/workload-overview.tsx",
    "src/client/components/issue-list.tsx",
    "src/server/index.ts"
  ]
}
